# Copy to .env and fill in. .env is gitignored and never echoed.
# Never paste a key into a chat or a shell command: provider secret-scanning
# revokes exposed keys within minutes.

CREDITPULSE_SEC_UA=CreditPulse IQ research you@example.edu

# Agent model (any OpenAI-compatible endpoint)
CREDITPULSE_LLM_BASE_URL=https://api.groq.com/openai/v1
CREDITPULSE_LLM_MODEL=openai/gpt-oss-20b
CREDITPULSE_LLM_API_KEY=

# Judge must be a different model (hard rule 7)
CREDITPULSE_JUDGE_MODEL=gemini-2.5-flash
