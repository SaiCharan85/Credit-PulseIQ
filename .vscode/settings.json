{
  // data/cache holds ~14k cached EDGAR files plus the Qdrant store and model
  // files. Indexing and watching it costs Pylance and the file watcher a lot
  // of memory on a machine that has crashed from memory pressure.
  "python.analysis.exclude": ["data/cache/**", "data/raw/**", "results/**", "**/__pycache__/**"],
  "files.watcherExclude": {
    "data/cache/**": true,
    "data/raw/**": true,
    "results/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "data/cache/**": true,
    "data/raw/**": true
  }
}
